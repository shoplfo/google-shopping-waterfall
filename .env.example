# ---------------------------------------------------------------------------
# Shopping Waterfall Engine — environment
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=3000
NODE_ENV=development

# Shared secret for cron + API-key requests. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=

# Signs dashboard login sessions. Use a DIFFERENT random value than above.
# Falls back to API_SECRET_KEY if unset, but a separate value is safer.
SESSION_SECRET=

# --- Supabase (Postgres + auth storage) ---
# From your Supabase project: Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Ads API ---
# Developer token: Google Ads -> Tools -> API Center (needs a manager/MCC account)
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client (type: Web application) from Google Cloud Console -> Credentials
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on that OAuth client.
# Local:      http://localhost:3000/api/oauth/google/callback
# Production: https://your-domain.com/api/oauth/google/callback
OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/google/callback

# --- Optional ---
# Search-term lookback window for each engine run.
# TODAY | YESTERDAY | LAST_7_DAYS | LAST_14_DAYS | LAST_30_DAYS
DEFAULT_DATE_RANGE=TODAY

# --- Seeding only (`npm run seed`) ---
# The seed script talks to the running server over HTTP, so it needs the
# server's URL and a valid API key. Not needed to run the app itself.
#   API_KEY must equal API_SECRET_KEY above.
API_BASE=http://localhost:3000
API_KEY=
# Point these at your own keyword files to seed something other than the
# defaults in sql/. See sql/*.furniture-example.json for the expected shape.
# MASTER_KEYWORDS_FILE=sql/seed-master-keywords.json
# GENERAL_NEGATIVES_FILE=sql/seed-general-negatives.json
